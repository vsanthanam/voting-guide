---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  image?: string; // path under public/, e.g. /og/2026-general.png
}
const { title, description, image = '/og/default.png' } = Astro.props;
const site = "Varun's Voting Guide";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title === site ? site : `${title} · ${site}`;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const imageUrl = Astro.site ? new URL(`${base}${image}`, Astro.site).href : `${base}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint so there is no flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topbar glass">
      <a class="brand" href={`${base}/`}>{site}</a>
      <nav><a href={`${base}/`}>All guides</a></nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container">
        <div class="footer-row">
          <nav class="footer-links" aria-label="Links">
            <a href="https://www.vsanthanam.com">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14v9H3z" /><path d="m3 6 7 5 7-5" /></svg>
              Contact me
            </a>
            <a href="https://github.com/vsanthanam/voting-guide">
              <svg viewBox="0 0 16 16" aria-hidden="true" class="fill"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
              GitHub
            </a>
            <a href="https://github.com/vsanthanam/voting-guide/issues/new">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5 2.5 16.5h15z" /><path d="M10 8v4M10 14.2v.3" /></svg>
              Report a mistake
            </a>
          </nav>
          <div class="theme" role="radiogroup" aria-label="Appearance">
            <button type="button" role="radio" data-theme-choice="auto">Auto</button>
            <button type="button" role="radio" data-theme-choice="light">Light</button>
            <button type="button" role="radio" data-theme-choice="dark">Dark</button>
          </div>
        </div>
        <p class="footer-note">Always double check the options written on your ballot.</p>
      </div>
    </footer>
    <script>
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
      const root = document.documentElement;
      const current = () => root.dataset.theme ?? 'auto';
      const paint = () => {
        const c = current();
        for (const b of buttons) b.setAttribute('aria-checked', String(b.dataset.themeChoice === c));
      };
      for (const b of buttons) {
        b.addEventListener('click', () => {
          const choice = b.dataset.themeChoice!;
          if (choice === 'auto') delete root.dataset.theme;
          else root.dataset.theme = choice;
          try {
            if (choice === 'auto') localStorage.removeItem('theme');
            else localStorage.setItem('theme', choice);
          } catch {}
          paint();
        });
      }
      paint();
    </script>
  </body>
</html>
