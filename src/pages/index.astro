---
import Base from '../layouts/Base.astro';
import { formatDate, loadAllGuides, stats } from '../lib/guide';
const guides = await loadAllGuides();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Varun's Voting Guide" description="Designed for voters in select cities in the San Francisco Bay Area.">
  <header class="masthead">
    <div class="container">
      <h1>Varun's Voting Guide</h1>
      <p class="lede">Designed for voters in select cities in the San Francisco Bay Area.</p>
    </div>
  </header>
  <main class="container home">
    {
      guides.map((lg) => {
        const s = stats(lg);
        const draft = lg.guide.data.status === 'draft';
        return (
          <a class="card row" href={`${base}/guides/${lg.guide.id}/`}>
            <span class="text">
              <span class="title">{lg.guide.data.election}</span>
              <span class="date">{formatDate(lg.guide.data.date)}</span>
              <span class="meta">
                {s.races} races, {s.measures} measures
              </span>
            </span>
            <span class="status">
              {draft ? <span class="label draft">In progress</span> : <span class="label yes">Complete</span>}
            </span>
            <svg class="chev" width="10" height="16" viewBox="0 0 10 16" aria-hidden="true"><path d="m2 2 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        );
      })
    }
  </main>
</Base>

<style>
  .home {
    padding-bottom: 120px;
    display: grid;
    gap: 16px;
    max-width: 680px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 0;
    padding: 26px 28px;
    color: var(--text);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .row:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 14px 40px rgba(0, 0, 0, 0.08);
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .title {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .date {
    color: var(--text-2);
  }
  .meta {
    font-size: 14px;
    color: var(--text-3);
  }
  .chev {
    color: var(--text-3);
    flex: none;
  }
  @media (max-width: 480px) {
    .row {
      flex-wrap: wrap;
      padding: 22px 22px;
    }
    .status {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
