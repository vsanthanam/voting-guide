---
/**
 * A selection circle standing in for a ballot oval.
 *   empty   – on the ballot, not picked
 *   filled  – picked (blue with a check)
 *   shared  – picked as one of an "either of these" pair (blue with a dash)
 *   struck  – do not vote for this person (red with an x)
 */
interface Props {
  state?: 'empty' | 'filled' | 'shared' | 'struck';
  label?: string;
}
const { state = 'empty', label } = Astro.props;
---

<span class:list={['mark', state]} role="img" aria-label={label ?? state}>
  {state === 'filled' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 10.5 3 3 6-7" /></svg>}
  {state === 'shared' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 10h8" /></svg>}
  {state === 'struck' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6.5 6.5 7 7m0-7-7 7" /></svg>}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    flex: none;
    vertical-align: middle;
    background: var(--card);
    box-shadow: inset 0 0 0 1.5px var(--hair-2);
  }
  .mark svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .filled,
  .shared {
    background: var(--blue);
    box-shadow: none;
  }
  .struck {
    background: var(--red-tint);
    box-shadow: none;
  }
  .struck svg {
    stroke: var(--red);
  }
</style>
