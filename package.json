{
  "name": "voting-guide",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "astro": "astro",
    "deploy": "SITE_URL=https://varunvotes.fyi bun --bun astro build && bun --bun wrangler deploy",
    "og": "bun scripts/og.mjs",
    "lint": "bun --bun eslint .",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "check": "bun run lint && bun run format:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.2",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.153.0"
  }
}
